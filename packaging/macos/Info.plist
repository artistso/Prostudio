<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ProStudio.app's Info.plist, its two versions filled in by package.sh: the release's as numbers
  alone (a beta's suffix left out, as the MSI's) and the build, prostudio.versionCode.
  The files the Finder may open with it: ProStudio's own artworks (its type, declared here), and
  the pictures, PSDs, PDFs, brushes and palettes the gallery's Import takes, as another app's.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ProStudio</string>
	<key>CFBundleExecutable</key>
	<string>prostudio</string>
	<key>CFBundleIconFile</key>
	<string>prostudio</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.artistso.prostudio</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ProStudio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ProStudio Artwork</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>CFBundleTypeIconFile</key>
			<string>prostudio</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.artistso.prostudio.artwork</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Picture</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.png</string>
				<string>public.jpeg</string>
				<string>public.tiff</string>
				<string>com.compuserve.gif</string>
				<string>com.microsoft.bmp</string>
				<string>org.webmproject.webp</string>
				<string>com.adobe.photoshop-image</string>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Brushes and Palettes</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>brush</string>
				<string>brushset</string>
				<string>abr</string>
				<string>gbr</string>
				<string>gih</string>
				<string>vbr</string>
				<string>kpp</string>
				<string>sut</string>
				<string>swatches</string>
				<string>ase</string>
				<string>aco</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.artistso.prostudio.artwork</string>
			<key>UTTypeDescription</key>
			<string>ProStudio Artwork</string>
			<key>UTTypeIconFile</key>
			<string>prostudio</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.composite-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>prostudio</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
